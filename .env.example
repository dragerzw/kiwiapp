ALPHA_VANTAGE_API_KEY=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=us-east-1

DEV_DATABASE_URL=sqlite+pysqlite:///dev.db
FLASK_ENV=development

# Optional local-development flags (all default to false)
AUTO_CREATE_SCHEMA=false
SEED_DEFAULT_DEV_USER=false
ENABLE_AUTH_JIT_PROVISIONING=false
ENABLE_DEBUG_AUTH_DIAGNOSTICS=false
DISABLE_OUTBOUND_PROXIES=false

# Required only when SEED_DEFAULT_DEV_USER=true
DEFAULT_DEV_USERNAME=
DEFAULT_DEV_PASSWORD=
DEFAULT_DEV_FIRSTNAME=Dev
DEFAULT_DEV_LASTNAME=User
DEFAULT_DEV_BALANCE=1000.0
